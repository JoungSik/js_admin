<div class="mb-8">
  <div class="mb-2 text-sm text-slate-500 dark:text-slate-400">
    <%= link_to t("js_admin.navigation.home"), root_path, class: "hover:text-slate-950 dark:hover:text-slate-100" %> /
    <%= link_to @resource.label, resources_path(@resource.model_id), class: "hover:text-slate-950 dark:hover:text-slate-100" %> /
    <%= link_to @resource.display_name(@record), resource_path(@resource.model_id, @record), class: "hover:text-slate-950 dark:hover:text-slate-100" %> /
    <%= t("js_admin.resources.actions.edit") %>
  </div>
  <h1 class="text-2xl font-semibold text-slate-950 dark:text-slate-100"><%= t("js_admin.resources.headings.edit", record: @resource.display_name(@record)) %></h1>
</div>

<%= render "form", record: @record, resource: @resource, url: resource_path(@resource.model_id, @record) %>
