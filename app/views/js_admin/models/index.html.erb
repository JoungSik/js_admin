<% content_for :title, "JSAdmin Models" %>

<div class="mb-8">
  <h1 class="text-2xl font-semibold text-slate-950 dark:text-slate-100">Models</h1>
  <p class="mt-2 text-sm text-slate-600 dark:text-slate-400"><%= pluralize(@resources.size, "model") %> available</p>
</div>

<div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
  <ul class="divide-y divide-slate-200 dark:divide-slate-800">
    <% @resources.each do |resource| %>
      <li>
        <%= link_to resources_path(resource.model_id), class: "flex items-center justify-between gap-6 px-5 py-5 hover:bg-slate-50 dark:hover:bg-slate-800/70 sm:px-6" do %>
          <span>
            <span class="block text-sm font-medium text-slate-950 dark:text-slate-100"><%= resource.label %></span>
            <span class="mt-1.5 block text-xs text-slate-500 dark:text-slate-400"><%= resource.model_class.name %></span>
          </span>
          <span class="text-sm text-slate-500 dark:text-slate-400"><%= number_with_delimiter(resource.count) %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
