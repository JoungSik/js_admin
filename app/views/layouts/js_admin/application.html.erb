<!DOCTYPE html>
<html class="<%= js_admin_html_classes %>">
<head>
  <title><%= content_for(:title) || "JSAdmin" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <%= js_admin_stylesheet_link_tag "tailwind" %>
  <%= stylesheet_link_tag "js_admin/application", media: "all", "data-turbo-track": "reload" %>
  <%= js_admin_javascript_tags %>
</head>
<body class="min-h-screen bg-slate-50 text-slate-950 antialiased dark:bg-slate-950 dark:text-slate-100" data-controller="js-admin-theme">
  <div class="min-h-screen">
    <header class="fixed inset-x-0 top-0 z-40 border-b border-slate-200 bg-white/95 dark:border-slate-800 dark:bg-slate-900/95">
      <div class="flex min-h-16 w-full items-center">
        <div class="flex min-h-16 shrink-0 items-center px-5 sm:px-8 lg:w-64 lg:border-r lg:border-slate-200 lg:px-5 lg:dark:border-slate-800">
          <%= link_to "JSAdmin", root_path, class: "text-base font-semibold text-slate-950 dark:text-slate-100", data: js_admin_content_link_data %>
        </div>

        <div class="min-h-16 min-w-0 flex-1"></div>
      </div>
    </header>

    <div class="flex w-full flex-col pt-16 lg:flex-row">
      <%= render "layouts/js_admin/sidebar" %>

      <main class="min-w-0 flex-1 px-5 py-8 sm:px-8 sm:py-10 lg:px-10">
        <div class="mx-auto max-w-screen-2xl">
          <%= yield %>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
